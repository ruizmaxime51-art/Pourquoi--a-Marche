# Ces valeurs sont injectées automatiquement par les intégrations Vercel.
# Ne jamais placer de vraie clé dans ce fichier ni dans Git.
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=chimiemaison.fr
UPSTASH_REDIS_REST_KV_REST_API_URL=
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=

# Facultatif : secret dédié au pseudonymat des adresses IP.
# Sans cette variable, la clé serveur Resend est utilisée comme clé HMAC.
RATE_LIMIT_SECRET=

# Option payante Vercel Web Analytics Pro/Enterprise. Désactivée par défaut.
# Activer seulement après vérification du plan et de l'information des lecteurs.
NEXT_PUBLIC_CONVERSION_EVENTS=false
